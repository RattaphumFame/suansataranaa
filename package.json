{
  "name": "bkk-parks-api",
  "version": "2.0.0",
  "description": "ระบบค้นหาสวนสาธารณะ (NestJS) - ทุก endpoint ดึงข้อมูลสดจากเว็บ greener.bangkok.go.th โดยตรงทุกครั้งที่เรียก (ไม่มีฐานข้อมูล) แล้ว geocode พิกัดด้วย OpenStreetMap Nominatim",
  "scripts": {
    "start": "node dist/api/src/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only api/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest --config jest.config.json api/test/haversine.spec.ts",
    "test:e2e": "jest --config jest.config.json api/test/parks.e2e-spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
